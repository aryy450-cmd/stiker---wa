import streamlit as st
from rembg import remove
from PIL import Image
import io

st.set_page_config(page_title="Bikin Stiker WA", page_icon="🎨")
st.title("🎨 Bikin Stiker WhatsApp Online")
st.write("Upload gambar, background auto ilang, langsung jadi stiker PNG transparan")

uploaded_file = st.file_uploader("Pilih gambar...", type=["png", "jpg", "jpeg"])

if uploaded_file is not None:
    image = Image.open(uploaded_file)
    st.image(image, caption="Gambar Asli", use_column_width=True)
    
    if st.button("Hapus Background + Jadiin Stiker"):
        with st.spinner("Lagi proses nih, sabar ya..."):
            img_no_bg = remove(image)
            
            buf = io.BytesIO()
            img_no_bg.save(buf, format="PNG")
            byte_im = buf.getvalue()
            
            st.image(img_no_bg, caption="Hasil Stiker Transparan", use_column_width=True)
            
            st.download_button(
                label="📥 Download Stiker PNG",
                data=byte_im,
                file_name="stiker_wa.png",
                mime="image/png"
            )
            st.success("Beress! Tinggal download terus kirim ke WA")
else:
    st.info("Upload gambar dulu be")
